<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>

<?import javafx.scene.layout.HBox?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            style="-fx-background-color: white;"
            fx:controller="controller.HomeController">

<top>

    <HBox spacing="10" alignment="CENTER_LEFT"
          style="-fx-background-color: #1A73E8; -fx-padding: 10;">

    <!-- LOGO -->
    <ImageView fitHeight="70" fitWidth="100">
        <image>
            <Image url="@/images/TripWise-removebg-preview.png"/>
        </image>
    </ImageView>

        <!-- Title -->
        <Label text="TripWise"
               style="-fx-font-size: 20px; -fx-text-fill: white; -fx-font-weight: bold;"/>
    </HBox>

    </top>
    <left>
        <VBox spacing="12" style="-fx-background-color: #E8F0FE; -fx-padding: 20;">
            <Button text="Flights" onAction="#openFlights"/>
            <Button text="Bookings" onAction="#openBookings"/>
            <Button text="Luggage" onAction="#openLuggage"/>
        </VBox>
    </left>
    <center>
        <VBox spacing="16" style="-fx-padding: 20;">
            <Label text="Welcome to TripWise!"
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1A73E8;"/>
            <Label text="Choose an option from the side menu to begin."
                   style="-fx-font-size: 14px; -fx-text-fill: #333;"/>
        </VBox>
    </center>
</BorderPane>
