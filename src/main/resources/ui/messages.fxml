<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="ui.controllers.MessagesController"
      spacing="24" style="-fx-background-color: #f5f7fa;">
    <padding>
        <Insets top="24" right="32" bottom="24" left="32" />
    </padding>

    <!-- Header -->
    <VBox spacing="6">
        <Label fx:id="pageTitle" text="Messages" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1a202c;" />
        <Label fx:id="pageSubtitle" text="Communicate with support" style="-fx-font-size: 14px; -fx-text-fill: #718096;" />
    </VBox>

    <!-- Stats Row -->
    <HBox spacing="20">
        <VBox spacing="8" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);"
              HBox.hgrow="ALWAYS">
            <Label fx:id="stat1Title" text="Stat 1" style="-fx-font-size: 12px; -fx-text-fill: #6b7280; -fx-font-weight: 500;" />
            <Label fx:id="stat1Label" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #1f2937;" />
        </VBox>
        
        <VBox spacing="8" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);"
              HBox.hgrow="ALWAYS">
            <Label fx:id="stat2Title" text="Stat 2" style="-fx-font-size: 12px; -fx-text-fill: #6b7280; -fx-font-weight: 500;" />
            <Label fx:id="stat2Label" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #1f2937;" />
        </VBox>
        
        <VBox spacing="8" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);"
              HBox.hgrow="ALWAYS">
            <Label fx:id="stat3Title" text="Stat 3" style="-fx-font-size: 12px; -fx-text-fill: #6b7280; -fx-font-weight: 500;" />
            <Label fx:id="stat3Label" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #1f2937;" />
        </VBox>
    </HBox>

    <!-- Chat Interface -->
    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <!-- Conversations List -->
        <VBox spacing="16" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);"
              prefWidth="340">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Conversations" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1f2937;" />
                <Region HBox.hgrow="ALWAYS" />
                <Button text="+" onAction="#handleNewConversation"
                       style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 6 12; -fx-cursor: hand; -fx-font-size: 16px; -fx-font-weight: bold;" />
            </HBox>

            <TextField promptText="Search conversations..." 
                      style="-fx-background-color: #f3f4f6; -fx-border-width: 0; -fx-background-radius: 8; -fx-padding: 10;" />

            <Separator style="-fx-background-color: #e5e7eb;" />

            <ListView fx:id="conversationsList" VBox.vgrow="ALWAYS"
                     style="-fx-background-color: transparent; -fx-background-insets: 0; -fx-border-width: 0;">
            </ListView>
        </VBox>

        <!-- Chat Window -->
        <VBox spacing="0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);"
              HBox.hgrow="ALWAYS">
            <!-- Chat Header -->
            <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-background-color: #f9fafb; -fx-background-radius: 12 12 0 0; -fx-padding: 20; -fx-border-color: #e5e7eb; -fx-border-width: 0 0 1 0;">
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label fx:id="chatHeaderName" text="Select a conversation" style="-fx-font-size: 16px; -fx-font-weight: 600; -fx-text-fill: #1f2937;" />
                    <Label fx:id="chatHeaderStatus" text="" style="-fx-font-size: 12px; -fx-text-fill: #10b981;" />
                </VBox>
                <Button text="⋮" style="-fx-background-color: transparent; -fx-text-fill: #6b7280; -fx-font-size: 20px; -fx-cursor: hand;" />
            </HBox>

            <!-- Chat Messages Area -->
            <ScrollPane fitToWidth="true" style="-fx-background-color: white; -fx-background: white;" VBox.vgrow="ALWAYS">
                <VBox fx:id="chatMessagesBox" spacing="8" style="-fx-padding: 20; -fx-background-color: white;">
                    <!-- Messages will be added dynamically -->
                </VBox>
            </ScrollPane>

            <!-- Message Input -->
            <HBox spacing="12" alignment="CENTER" style="-fx-padding: 20; -fx-border-color: #e5e7eb; -fx-border-width: 1 0 0 0;">
                <Button text="📎" style="-fx-background-color: #f3f4f6; -fx-text-fill: #6b7280; -fx-background-radius: 8; -fx-padding: 10 14; -fx-cursor: hand; -fx-font-size: 16px;" />
                <TextField fx:id="messageInput" promptText="Type your message..." 
                          style="-fx-background-color: #f3f4f6; -fx-border-width: 0; -fx-background-radius: 8; -fx-padding: 12;"
                          HBox.hgrow="ALWAYS"
                          onAction="#handleSendMessage" />
                <Button text="Send" onAction="#handleSendMessage"
                       style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 24; -fx-cursor: hand; -fx-font-size: 14px; -fx-font-weight: 600;" />
            </HBox>
        </VBox>
    </HBox>
</VBox>
