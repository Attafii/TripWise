<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="ui.controllers.admin.AdminDashboardController">

    <left>
        <VBox spacing="12" alignment="TOP_LEFT" styleClass="sidebar" prefWidth="220">
            <children>
                <Label text="TripWise Admin"
                       style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white; -fx-padding: 10;" />

                <Button text="Users" onAction="#openUsers" styleClass="sidebar-button"/>
                <Button text="Reservations" onAction="#openReservations" styleClass="sidebar-button"/>
                <Button text="Notifications" onAction="#openNotifications" styleClass="sidebar-button"/>
                <Button text="Reports" onAction="#openReports" styleClass="sidebar-button"/>

                <Region VBox.vgrow="ALWAYS"/>
                <Button text="Back to App" onAction="#backToApp" styleClass="logout-button"/>
            </children>
        </VBox>
    </left>

    <center>
        <BorderPane>
            <top>
                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="top-bar">
                    <children>
                        <Label text="Admin" styleClass="page-title"/>
                    </children>
                </HBox>
            </top>
            <center>
                <StackPane fx:id="contentArea"/>
            </center>
        </BorderPane>
    </center>
</BorderPane>