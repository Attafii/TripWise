<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="ui.controllers.admin.AdminReportsController"
      spacing="10" styleClass="view-root">

    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label text="Reports Statistics" styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Export CSV" onAction="#onExportCSV"/>
        <Button text="Refresh" onAction="#onRefresh"/>
    </HBox>

    <GridPane hgap="16" vgap="8">
        <Label text="Total Reservations:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <Label fx:id="lblTotalReservations" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Total Amount:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <Label fx:id="lblTotalAmount" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Active Users:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <Label fx:id="lblActiveUsers" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    </GridPane>

    <TableView fx:id="topUsersTable" prefHeight="420">
        <columns>
            <TableColumn fx:id="colUEmail" text="User" prefWidth="260"/>
            <TableColumn fx:id="colUCount" text="Reservations" prefWidth="160"/>
            <TableColumn fx:id="colUAmount" text="Amount" prefWidth="180"/>
        </columns>
    </TableView>
</VBox>