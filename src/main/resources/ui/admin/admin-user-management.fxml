<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="rootPane" xmlns:fx="http://javafx.com/fxml" 
           fx:controller="ui.controllers.admin.AdminUserController"
           styleClass="root-pane">
    
    <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="scroll-pane">
        <HBox spacing="25" styleClass="admin-container">
            
            <!-- Left Panel - Table -->
            <VBox spacing="20" HBox.hgrow="ALWAYS" styleClass="table-panel">
                
                <!-- Header -->
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Label text="User Management" styleClass="page-title" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnExportPDF" text="📄 PDF" onAction="#handleExportPDF" styleClass="btn-secondary" />
                    <Button fx:id="btnExportExcel" text="📊 Excel" onAction="#handleExportExcel" styleClass="btn-secondary" />
                </HBox>
                
                <!-- Search and Filters -->
                <HBox spacing="15" alignment="CENTER_LEFT" styleClass="filter-bar">
                    <TextField fx:id="txtSearch" promptText="Search by name or email..." 
                              styleClass="search-field" HBox.hgrow="ALWAYS" />
                    <ComboBox fx:id="cbFilterType" promptText="Filter by Type" styleClass="filter-combo" />
                    <ComboBox fx:id="cbFilterStatus" styleClass="filter-combo" />
                </HBox>
                
                <!-- User Table -->
                <VBox spacing="0" styleClass="table-container" VBox.vgrow="ALWAYS">
                    <TableView fx:id="userTable" VBox.vgrow="ALWAYS" styleClass="data-table">
                        <columns>
                            <TableColumn fx:id="colId" text="ID" prefWidth="60" />
                            <TableColumn fx:id="colName" text="Full Name" prefWidth="180" />
                            <TableColumn fx:id="colEmail" text="Email" prefWidth="200" />
                            <TableColumn fx:id="colPhone" text="Phone" prefWidth="130" />
                            <TableColumn fx:id="colType" text="Type" prefWidth="120" />
                            <TableColumn fx:id="colStatus" text="Status" prefWidth="100" />
                        </columns>
                    </TableView>
                </VBox>
            </VBox>
            
            <!-- Right Panel - Form -->
            <VBox spacing="20" prefWidth="400" styleClass="form-panel">
                
                <!-- Form Header -->
                <Label text="User Details" styleClass="form-title" />
                
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="form-scroll">
                    <VBox spacing="15">
                        
                        <!-- Basic Information -->
                        <VBox spacing="10" styleClass="form-section">
                            <Label text="Basic Information" styleClass="section-title" />
                            
                            <!-- First Name -->
                            <VBox spacing="5">
                                <Label text="First Name *" styleClass="field-label" />
                                <TextField fx:id="txtFirstName" promptText="Enter first name" styleClass="form-field" />
                            </VBox>
                            
                            <!-- Last Name -->
                            <VBox spacing="5">
                                <Label text="Last Name *" styleClass="field-label" />
                                <TextField fx:id="txtLastName" promptText="Enter last name" styleClass="form-field" />
                            </VBox>
                            
                            <!-- Email -->
                            <VBox spacing="5">
                                <Label text="Email *" styleClass="field-label" />
                                <TextField fx:id="txtEmail" promptText="email@example.com" styleClass="form-field" />
                                <Label fx:id="lblEmailError" text="Invalid email format" 
                                       styleClass="error-label" visible="false" />
                            </VBox>
                            
                            <!-- Phone -->
                            <VBox spacing="5">
                                <Label text="Phone Number" styleClass="field-label" />
                                <TextField fx:id="txtPhone" promptText="+1 (555) 123-4567" styleClass="form-field" />
                                <Label fx:id="lblPhoneError" text="Invalid phone format" 
                                       styleClass="error-label" visible="false" />
                            </VBox>
                            
                            <!-- Password -->
                            <VBox spacing="5">
                                <Label text="Password *" styleClass="field-label" />
                                <PasswordField fx:id="txtPassword" promptText="Min 8 chars, letter + number" 
                                              styleClass="form-field" />
                                <Label fx:id="lblPasswordError" text="Password requirements not met" 
                                       styleClass="error-label" visible="false" />
                            </VBox>
                            
                            <!-- User Type -->
                            <VBox spacing="5">
                                <Label text="User Type *" styleClass="field-label" />
                                <ComboBox fx:id="cbUserType" promptText="Select user type" 
                                         styleClass="form-field" maxWidth="Infinity" />
                            </VBox>
                        </VBox>
                        
                        <!-- Personal Details -->
                        <VBox spacing="10" styleClass="form-section">
                            <Label text="Personal Details" styleClass="section-title" />
                            
                            <!-- Date of Birth -->
                            <VBox spacing="5">
                                <Label text="Date of Birth" styleClass="field-label" />
                                <DatePicker fx:id="dpDateOfBirth" promptText="Select date" 
                                           styleClass="form-field" maxWidth="Infinity" />
                            </VBox>
                            
                            <!-- Nationality -->
                            <VBox spacing="5">
                                <Label text="Nationality" styleClass="field-label" />
                                <TextField fx:id="txtNationality" promptText="Enter nationality" 
                                          styleClass="form-field" />
                            </VBox>
                            
                            <!-- Passport Number -->
                            <VBox spacing="5">
                                <Label text="Passport Number" styleClass="field-label" />
                                <TextField fx:id="txtPassport" promptText="Enter passport number" 
                                          styleClass="form-field" />
                            </VBox>
                            
                            <!-- Address -->
                            <VBox spacing="5">
                                <Label text="Address" styleClass="field-label" />
                                <TextArea fx:id="txtAddress" promptText="Enter full address" 
                                         styleClass="form-field" prefRowCount="3" />
                            </VBox>
                        </VBox>
                        
                        <!-- Status -->
                        <VBox spacing="10" styleClass="form-section">
                            <Label text="Account Status" styleClass="section-title" />
                            <CheckBox fx:id="chkActive" text="Active Account" styleClass="form-checkbox" 
                                     selected="true" />
                        </VBox>
                        
                        <padding>
                            <Insets top="10" right="10" bottom="10" left="10" />
                        </padding>
                    </VBox>
                </ScrollPane>
                
                <!-- Action Buttons -->
                <HBox spacing="10" alignment="CENTER">
                    <Button fx:id="btnAdd" text="➕ Add User" onAction="#handleAdd" 
                           styleClass="btn-primary" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                    <Button fx:id="btnUpdate" text="✏️ Update" onAction="#handleUpdate" 
                           styleClass="btn-success" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                </HBox>
                
                <HBox spacing="10" alignment="CENTER">
                    <Button fx:id="btnDelete" text="🗑️ Delete" onAction="#handleDelete" 
                           styleClass="btn-danger" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                    <Button fx:id="btnClear" text="🔄 Clear" onAction="#handleClear" 
                           styleClass="btn-secondary" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                </HBox>
            </VBox>
            
            <padding>
                <Insets top="30" right="30" bottom="30" left="30" />
            </padding>
        </HBox>
    </ScrollPane>
</StackPane>
