<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="ui.controllers.ScheduleController"
      spacing="24" style="-fx-background-color: #f5f7fa;">
    <padding>
        <Insets top="24" right="32" bottom="24" left="32" />
    </padding>

    <!-- Header -->
    <VBox spacing="6">
        <Label fx:id="pageTitle" text="Schedule" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1a202c;" />
        <Label fx:id="pageSubtitle" text="Manage your schedule" style="-fx-font-size: 14px; -fx-text-fill: #718096;" />
    </VBox>

    <!-- Stats Row -->
    <HBox spacing="20">
        <VBox spacing="8" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);"
              HBox.hgrow="ALWAYS">
            <Label fx:id="stat1Title" text="Stat 1" style="-fx-font-size: 12px; -fx-text-fill: #6b7280; -fx-font-weight: 500;" />
            <Label fx:id="stat1Label" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #1f2937;" />
        </VBox>
        
        <VBox spacing="8" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);"
              HBox.hgrow="ALWAYS">
            <Label fx:id="stat2Title" text="Stat 2" style="-fx-font-size: 12px; -fx-text-fill: #6b7280; -fx-font-weight: 500;" />
            <Label fx:id="stat2Label" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #1f2937;" />
        </VBox>
        
        <VBox spacing="8" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);"
              HBox.hgrow="ALWAYS">
            <Label fx:id="stat3Title" text="Stat 3" style="-fx-font-size: 12px; -fx-text-fill: #6b7280; -fx-font-weight: 500;" />
            <Label fx:id="stat3Label" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #1f2937;" />
        </VBox>
    </HBox>

    <!-- Main Content -->
    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <!-- Calendar Section -->
        <VBox spacing="16" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);"
              HBox.hgrow="ALWAYS">
            <!-- Calendar Header -->
            <HBox spacing="12" alignment="CENTER">
                <Button text="←" onAction="#handlePreviousMonth" 
                       style="-fx-background-color: #f3f4f6; -fx-text-fill: #374151; -fx-background-radius: 8; -fx-padding: 8 16; -fx-cursor: hand; -fx-font-size: 16px; -fx-font-weight: bold;" />
                <Label fx:id="monthYearLabel" text="December 2024" 
                      style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1f2937;" HBox.hgrow="ALWAYS" alignment="CENTER" />
                <Button text="Today" onAction="#handleToday"
                       style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 16; -fx-cursor: hand; -fx-font-size: 13px; -fx-font-weight: 600;" />
                <Button text="→" onAction="#handleNextMonth"
                       style="-fx-background-color: #f3f4f6; -fx-text-fill: #374151; -fx-background-radius: 8; -fx-padding: 8 16; -fx-cursor: hand; -fx-font-size: 16px; -fx-font-weight: bold;" />
            </HBox>

            <!-- Calendar Grid -->
            <GridPane fx:id="calendarGrid" hgap="8" vgap="8" alignment="CENTER">
            </GridPane>

            <!-- Add Event Button -->
            <Button text="+ Add Event" onAction="#handleAddEvent"
                   style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 12 24; -fx-cursor: hand; -fx-font-size: 14px; -fx-font-weight: 600; -fx-pref-width: 100%;" />
        </VBox>

        <!-- Upcoming Events Section -->
        <VBox spacing="16" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);"
              prefWidth="380">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Upcoming Events" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1f2937;" />
                <Region HBox.hgrow="ALWAYS" />
                <Label text="Next 7 Days" style="-fx-font-size: 12px; -fx-text-fill: #6b7280; -fx-background-color: #f3f4f6; -fx-padding: 4 12; -fx-background-radius: 12;" />
            </HBox>

            <Separator style="-fx-background-color: #e5e7eb;" />

            <!-- Events List -->
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                <VBox fx:id="upcomingEventsBox" spacing="12" style="-fx-background-color: transparent;">
                </VBox>
            </ScrollPane>
        </VBox>
    </HBox>
</VBox>
