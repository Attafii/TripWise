<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="ui.controllers.CapacityManagementController"
            prefWidth="1100" prefHeight="750" style="-fx-background-color: #f5f6fa;">

    <stylesheets>
        <String fx:value="@style.css"/>
    </stylesheets>

    <!-- Top Header -->
    <top>
        <VBox style="-fx-background-color: linear-gradient(to right, #667eea, #764ba2); -fx-padding: 20;">
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label text="📊 Capacity Management" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnRefresh" text="🔄 Refresh" style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-cursor: hand;" onAction="#handleRefresh"/>
                <Button fx:id="btnExportExcel" text="📥 Export Excel" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-cursor: hand;" onAction="#handleExportExcel"/>
                <Button fx:id="btnExportPDF" text="📄 Export PDF" style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-cursor: hand;" onAction="#handleExportPDF"/>
            </HBox>
        </VBox>
    </top>

    <!-- Main Content -->
    <center>
        <VBox spacing="20" style="-fx-padding: 20;">

            <!-- Statistics Cards Row -->
            <HBox spacing="20">
                <!-- Total Flights Card -->
                <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                    <Label text="Total Flights" style="-fx-text-fill: #666; -fx-font-size: 14px;"/>
                    <Label fx:id="lblTotalFlights" text="0" style="-fx-text-fill: #333; -fx-font-size: 32px; -fx-font-weight: bold;"/>
                    <Label text="Active scheduled" style="-fx-text-fill: #999; -fx-font-size: 11px;"/>
                </VBox>

                <!-- Total Capacity Card -->
                <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                    <Label text="Total Capacity" style="-fx-text-fill: #666; -fx-font-size: 14px;"/>
                    <Label fx:id="lblTotalCapacity" text="0" style="-fx-text-fill: #667eea; -fx-font-size: 32px; -fx-font-weight: bold;"/>
                    <Label text="seats available" style="-fx-text-fill: #999; -fx-font-size: 11px;"/>
                </VBox>

                <!-- Booked Seats Card -->
                <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                    <Label text="Booked Seats" style="-fx-text-fill: #666; -fx-font-size: 14px;"/>
                    <Label fx:id="lblBookedSeats" text="0" style="-fx-text-fill: #4CAF50; -fx-font-size: 32px; -fx-font-weight: bold;"/>
                    <Label fx:id="lblBookedPercent" text="0% occupancy" style="-fx-text-fill: #999; -fx-font-size: 11px;"/>
                </VBox>

                <!-- Available Seats Card -->
                <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                    <Label text="Available Seats" style="-fx-text-fill: #666; -fx-font-size: 14px;"/>
                    <Label fx:id="lblAvailableSeats" text="0" style="-fx-text-fill: #f39c12; -fx-font-size: 32px; -fx-font-weight: bold;"/>
                    <Label text="remaining" style="-fx-text-fill: #999; -fx-font-size: 11px;"/>
                </VBox>
            </HBox>

            <!-- Charts Row -->
            <HBox spacing="20" VBox.vgrow="ALWAYS">
                <!-- Class Distribution Chart -->
                <VBox spacing="10" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                    <Label text="Capacity by Class" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                    <PieChart fx:id="classDistributionChart" prefHeight="250" legendVisible="true"/>
                </VBox>

                <!-- Occupancy by Route Chart -->
                <VBox spacing="10" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                    <Label text="Top Routes by Occupancy" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                    <BarChart fx:id="routeOccupancyChart" prefHeight="250">
                        <xAxis>
                            <CategoryAxis label="Route"/>
                        </xAxis>
                        <yAxis>
                            <NumberAxis label="Occupancy %" upperBound="100"/>
                        </yAxis>
                    </BarChart>
                </VBox>
            </HBox>

            <!-- Flights Table -->
            <VBox spacing="10" VBox.vgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">

                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Label text="Flight Capacity Details" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Filter:"/>
                    <ComboBox fx:id="cmbFilter" promptText="All Flights">
                        <items>
                            <javafx.collections.FXCollections fx:factory="observableArrayList">
                                <String fx:value="All Flights"/>
                                <String fx:value="Low Occupancy (&lt;30%)"/>
                                <String fx:value="Medium (30-70%)"/>
                                <String fx:value="High Occupancy (&gt;70%)"/>
                                <String fx:value="Nearly Full (&gt;90%)"/>
                            </javafx.collections.FXCollections>
                        </items>
                    </ComboBox>
                    <TextField fx:id="txtSearch" promptText="Search flight..." prefWidth="200"/>
                </HBox>

                <TableView fx:id="tblCapacity" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colFlight" text="Flight" prefWidth="80"/>
                        <TableColumn fx:id="colRoute" text="Route" prefWidth="180"/>
                        <TableColumn fx:id="colDeparture" text="Departure" prefWidth="130"/>
                        <TableColumn fx:id="colAirline" text="Airline" prefWidth="120"/>
                        <TableColumn fx:id="colTotal" text="Total" prefWidth="60"/>
                        <TableColumn fx:id="colBooked" text="Booked" prefWidth="60"/>
                        <TableColumn fx:id="colAvailable" text="Available" prefWidth="70"/>
                        <TableColumn fx:id="colOccupancy" text="Occupancy" prefWidth="100"/>
                        <TableColumn fx:id="colStatus" text="Status" prefWidth="100"/>
                        <TableColumn fx:id="colActions" text="Actions" prefWidth="100"/>
                    </columns>
                    <placeholder>
                        <Label text="No flights found"/>
                    </placeholder>
                </TableView>
            </VBox>

        </VBox>
    </center>

    <!-- Bottom Status -->
    <bottom>
        <HBox alignment="CENTER" spacing="20" style="-fx-background-color: #f8f9fa; -fx-padding: 10;">
            <Label fx:id="lblLastUpdated" text="Last updated: --" style="-fx-text-fill: #666;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox spacing="15">
                <HBox spacing="5" alignment="CENTER">
                    <Label style="-fx-background-color: #4CAF50; -fx-min-width: 12; -fx-min-height: 12; -fx-background-radius: 2;"/>
                    <Label text="High (>70%)" style="-fx-font-size: 11px;"/>
                </HBox>
                <HBox spacing="5" alignment="CENTER">
                    <Label style="-fx-background-color: #f39c12; -fx-min-width: 12; -fx-min-height: 12; -fx-background-radius: 2;"/>
                    <Label text="Medium (30-70%)" style="-fx-font-size: 11px;"/>
                </HBox>
                <HBox spacing="5" alignment="CENTER">
                    <Label style="-fx-background-color: #e74c3c; -fx-min-width: 12; -fx-min-height: 12; -fx-background-radius: 2;"/>
                    <Label text="Low (&lt;30%)" style="-fx-font-size: 11px;"/>
                </HBox>
            </HBox>
        </HBox>
    </bottom>

</BorderPane>
