<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="ui.controllers.FlightTrackingController"
      spacing="24" style="-fx-background-color: #f5f7fa;">
    <padding>
        <Insets top="24" right="32" bottom="24" left="32" />
    </padding>

    <!-- Header -->
    <VBox spacing="6">
        <Label fx:id="pageTitle" text="Flight Tracking" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1a202c;" />
        <Label fx:id="pageSubtitle" text="Real-time flight status and tracking" style="-fx-font-size: 14px; -fx-text-fill: #718096;" />
    </VBox>

    <!-- Stats Row -->
    <HBox spacing="20">
        <VBox spacing="8" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);"
              HBox.hgrow="ALWAYS">
            <Label fx:id="stat1Title" text="Stat 1" style="-fx-font-size: 12px; -fx-text-fill: #6b7280; -fx-font-weight: 500;" />
            <Label fx:id="stat1Label" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #1f2937;" />
        </VBox>
        
        <VBox spacing="8" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);"
              HBox.hgrow="ALWAYS">
            <Label fx:id="stat2Title" text="Stat 2" style="-fx-font-size: 12px; -fx-text-fill: #6b7280; -fx-font-weight: 500;" />
            <Label fx:id="stat2Label" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #1f2937;" />
        </VBox>
        
        <VBox spacing="8" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);"
              HBox.hgrow="ALWAYS">
            <Label fx:id="stat3Title" text="Stat 3" style="-fx-font-size: 12px; -fx-text-fill: #6b7280; -fx-font-weight: 500;" />
            <Label fx:id="stat3Label" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #1f2937;" />
        </VBox>
    </HBox>

    <!-- Main Content -->
    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <!-- Flights List -->
        <VBox spacing="16" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);"
              HBox.hgrow="ALWAYS">
            <HBox spacing="12" alignment="CENTER_LEFT">
                <HBox spacing="8" alignment="CENTER_LEFT" 
                      style="-fx-background-color: #f3f4f6; -fx-background-radius: 8; -fx-padding: 10 16;"
                      HBox.hgrow="ALWAYS">
                    <Label text="🔍" style="-fx-font-size: 16px;" />
                    <TextField fx:id="searchField" promptText="Search flights by number, airline, or route"
                              onKeyReleased="#handleSearch"
                              style="-fx-background-color: transparent; -fx-border-width: 0; -fx-font-size: 14px;"
                              HBox.hgrow="ALWAYS" />
                </HBox>
                <Button text="🔄 Refresh" onAction="#handleRefresh"
                       style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand; -fx-font-size: 13px; -fx-font-weight: 600;" />
            </HBox>

            <Separator style="-fx-background-color: #e5e7eb;" />

            <!-- Flights List -->
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                <VBox fx:id="flightsListBox" spacing="16" style="-fx-background-color: transparent;">
                </VBox>
            </ScrollPane>
        </VBox>

        <!-- Live Map / Info Panel -->
        <VBox spacing="16" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);"
              prefWidth="350">
            <Label text="Live Tracking" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1f2937;" />
            
            <Separator style="-fx-background-color: #e5e7eb;" />

            <!-- Map Placeholder -->
            <StackPane VBox.vgrow="ALWAYS" style="-fx-background-color: #eff6ff; -fx-background-radius: 12;">
                <Label fx:id="mapLabel" text="🗺️ Flight Map" 
                      style="-fx-text-fill: #3b82f6; -fx-font-size: 14px; -fx-text-alignment: center; -fx-padding: 40;"
                      wrapText="true" />
            </StackPane>

            <VBox spacing="12" style="-fx-padding: 12 0 0 0;">
                <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 10; -fx-background-color: #f9fafb; -fx-background-radius: 8;">
                    <Label text="🟢" style="-fx-font-size: 12px;" />
                    <Label text="On Time" style="-fx-font-size: 12px; -fx-text-fill: #6b7280;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label text="85%" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #10b981;" />
                </HBox>

                <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 10; -fx-background-color: #f9fafb; -fx-background-radius: 8;">
                    <Label text="🟡" style="-fx-font-size: 12px;" />
                    <Label text="Delayed" style="-fx-font-size: 12px; -fx-text-fill: #6b7280;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label text="10%" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #f59e0b;" />
                </HBox>

                <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 10; -fx-background-color: #f9fafb; -fx-background-radius: 8;">
                    <Label text="🔴" style="-fx-font-size: 12px;" />
                    <Label text="Cancelled" style="-fx-font-size: 12px; -fx-text-fill: #6b7280;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label text="5%" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #ef4444;" />
                </HBox>
            </VBox>
        </VBox>
    </HBox>
</VBox>
