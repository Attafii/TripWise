<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns:fx="http://javafx.com/fxml" fx:controller="ui.controllers.FlightTrackingController"
            fitToWidth="true" style="-fx-background-color: #f8f9fa; -fx-border-color: transparent;">
    <VBox spacing="25" style="-fx-background-color: #f8f9fa; -fx-padding: 25;">

        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="15">
            <VBox spacing="3">
                <Label text="Flight Tracking" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                <Label text="Track your flights in real-time" style="-fx-font-size: 14px; -fx-text-fill: #6b7280;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Refresh" onAction="#refreshTracking"
                   style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand;"/>
        </HBox>

        <!-- Search Flight -->
        <HBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20;">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Track Any Flight" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                <HBox spacing="10">
                    <TextField fx:id="flightNumberField" promptText="Enter flight number (e.g., AF001)" HBox.hgrow="ALWAYS"
                              style="-fx-background-radius: 8; -fx-padding: 12;"/>
                    <Button text="Track Flight" onAction="#trackFlight"
                           style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 12 25; -fx-cursor: hand;"/>
                </HBox>
            </VBox>
        </HBox>

        <!-- Tracked Flight Result -->
        <VBox fx:id="trackedFlightContainer" spacing="15" managed="false" visible="false"
              style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 25;">
        </VBox>

        <!-- My Flights Section -->
        <VBox spacing="15">
            <Label text="My Upcoming Flights" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>

            <VBox fx:id="myFlightsContainer" spacing="15">
            </VBox>
        </VBox>

        <!-- Recent Flight Status -->
        <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20;">
            <Label text="Flight Status Legend" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
            <HBox spacing="30">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="" style="-fx-background-color: #10b981; -fx-min-width: 12; -fx-min-height: 12; -fx-background-radius: 6;"/>
                    <Label text="On Time" style="-fx-font-size: 13px; -fx-text-fill: #374151;"/>
                </HBox>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="" style="-fx-background-color: #f59e0b; -fx-min-width: 12; -fx-min-height: 12; -fx-background-radius: 6;"/>
                    <Label text="Delayed" style="-fx-font-size: 13px; -fx-text-fill: #374151;"/>
                </HBox>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="" style="-fx-background-color: #3b82f6; -fx-min-width: 12; -fx-min-height: 12; -fx-background-radius: 6;"/>
                    <Label text="In Flight" style="-fx-font-size: 13px; -fx-text-fill: #374151;"/>
                </HBox>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="" style="-fx-background-color: #8b5cf6; -fx-min-width: 12; -fx-min-height: 12; -fx-background-radius: 6;"/>
                    <Label text="Landed" style="-fx-font-size: 13px; -fx-text-fill: #374151;"/>
                </HBox>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="" style="-fx-background-color: #ef4444; -fx-min-width: 12; -fx-min-height: 12; -fx-background-radius: 6;"/>
                    <Label text="Cancelled" style="-fx-font-size: 13px; -fx-text-fill: #374151;"/>
                </HBox>
            </HBox>
        </VBox>

    </VBox>
</ScrollPane>

