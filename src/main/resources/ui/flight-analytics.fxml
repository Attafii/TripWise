<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>

<ScrollPane xmlns:fx="http://javafx.com/fxml" fx:controller="ui.controllers.FlightAnalyticsController"
            stylesheets="@style.css" fitToWidth="true" style="-fx-background-color: #f8f9fa; -fx-border-color: transparent;">
    <VBox spacing="25" style="-fx-background-color: #f8f9fa; -fx-padding: 25;">

        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="15">
            <VBox spacing="3">
                <Label text="Flight Analytics" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                <Label text="Track your travel statistics and insights" style="-fx-font-size: 14px; -fx-text-fill: #6b7280;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="🤖 AI Insights" onAction="#handleAIInsights"
                   style="-fx-background-color: #8b5cf6; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand;"/>
            <Button text="📊 Generate Report" onAction="#handleGenerateReport"
                   style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand;"/>
        </HBox>

        <!-- Stats Cards Row -->
        <HBox spacing="15">
            <!-- Total Flights -->
            <VBox spacing="10" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="✈️" style="-fx-font-size: 24px; -fx-background-color: #eff6ff; -fx-padding: 10; -fx-background-radius: 10;"/>
                    <Label text="Total Flights" style="-fx-font-size: 14px; -fx-text-fill: #6b7280;"/>
                </HBox>
                <Label fx:id="totalFlightsLabel" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                <Label fx:id="totalFlightsTrendLabel" text="+0% from last month" style="-fx-font-size: 12px; -fx-text-fill: #10b981;"/>
            </VBox>

            <!-- Total Spent -->
            <VBox spacing="10" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="💰" style="-fx-font-size: 24px; -fx-background-color: #f0fdf4; -fx-padding: 10; -fx-background-radius: 10;"/>
                    <Label text="Total Spent" style="-fx-font-size: 14px; -fx-text-fill: #6b7280;"/>
                </HBox>
                <Label fx:id="totalSpentLabel" text="0.00" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                <Label fx:id="avgFlightPriceLabel" text="Average per flight" style="-fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
            </VBox>

            <!-- Countries Visited -->
            <VBox spacing="10" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="🌍" style="-fx-font-size: 24px; -fx-background-color: #fef3c7; -fx-padding: 10; -fx-background-radius: 10;"/>
                    <Label text="Destinations" style="-fx-font-size: 14px; -fx-text-fill: #6b7280;"/>
                </HBox>
                <Label fx:id="destinationsLabel" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                <Label fx:id="mostVisitedLabel" text="Most visited: N/A" style="-fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
            </VBox>

            <!-- Upcoming Flights -->
            <VBox spacing="10" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="📅" style="-fx-font-size: 24px; -fx-background-color: #fae8ff; -fx-padding: 10; -fx-background-radius: 10;"/>
                    <Label text="Upcoming" style="-fx-font-size: 14px; -fx-text-fill: #6b7280;"/>
                </HBox>
                <Label fx:id="upcomingFlightsLabel" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                <Label fx:id="nextFlightLabel" text="Next: N/A" style="-fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
            </VBox>
        </HBox>

        <!-- Charts Row -->
        <HBox spacing="20">
            <!-- Spending Chart -->
            <VBox spacing="15" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                <Label text="Monthly Spending" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                <LineChart fx:id="spendingChart" prefHeight="300" legendVisible="false">
                    <xAxis>
                        <CategoryAxis side="BOTTOM" />
                    </xAxis>
                    <yAxis>
                        <NumberAxis side="LEFT" label="Amount (USD)" />
                    </yAxis>
                </LineChart>
            </VBox>

            <!-- Class Distribution -->
            <VBox spacing="15" prefWidth="400" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                <Label text="Flight Class Distribution" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                <PieChart fx:id="classDistributionChart" prefHeight="300" legendSide="BOTTOM"/>
            </VBox>
        </HBox>

        <!-- Popular Routes and Airlines -->
        <HBox spacing="20">
            <!-- Popular Routes -->
            <VBox spacing="15" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                <Label text="Most Popular Routes" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                <VBox fx:id="popularRoutesContainer" spacing="12">
                    <!-- Routes will be added dynamically -->
                </VBox>
            </VBox>

            <!-- Favorite Airlines -->
            <VBox spacing="15" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                <Label text="Favorite Airlines" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                <VBox fx:id="favoriteAirlinesContainer" spacing="12">
                    <!-- Airlines will be added dynamically -->
                </VBox>
            </VBox>
        </HBox>

        <!-- Travel Timeline -->
        <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label text="Your Travel Timeline" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="timelineFilterCombo" promptText="All Time" prefWidth="150"
                         style="-fx-background-color: #f9fafb; -fx-background-radius: 8;"/>
            </HBox>
            <ScrollPane fitToWidth="true" prefHeight="300" style="-fx-background-color: transparent; -fx-border-color: transparent;">
                <VBox fx:id="timelineContainer" spacing="15" style="-fx-padding: 10;">
                    <!-- Timeline events will be added dynamically -->
                </VBox>
            </ScrollPane>
        </VBox>

        <!-- AI Insights Card -->
        <VBox spacing="15" style="-fx-background-color: linear-gradient(to right, #8b5cf6, #6366f1); -fx-background-radius: 16; -fx-padding: 25;">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="🤖" style="-fx-font-size: 28px;"/>
                <Label text="AI-Powered Travel Insights" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            </HBox>
            <Label fx:id="aiInsightsLabel" text="Loading insights..."
                  style="-fx-font-size: 15px; -fx-text-fill: white;" wrapText="true"/>
            <HBox spacing="10">
                <Button text="Get Personalized Recommendations" onAction="#handlePersonalizedRecommendations"
                       style="-fx-background-color: white; -fx-text-fill: #8b5cf6; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand; -fx-font-weight: 600;"/>
                <Button text="Optimize Future Bookings" onAction="#handleOptimizeBookings"
                       style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand;"/>
            </HBox>
        </VBox>

    </VBox>
</ScrollPane>
