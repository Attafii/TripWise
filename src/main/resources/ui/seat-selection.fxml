<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.*?>
<?import javafx.scene.shape.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="ui.controllers.SeatSelectionController"
            prefWidth="900" prefHeight="700" styleClass="seat-selection-page">

    <!-- Inline Styles -->
    <stylesheets>
        <String fx:value="@style.css"/>
    </stylesheets>

    <!-- Header -->
    <top>
        <VBox spacing="10" style="-fx-background-color: linear-gradient(to right, #667eea, #764ba2); -fx-padding: 20;">
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Button fx:id="btnBack" text="← Back" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-cursor: hand;"/>
                <Label text="Select Your Seats" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <VBox alignment="CENTER_RIGHT">
                    <Label fx:id="lblFlightNumber" text="AF 1234" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                    <Label fx:id="lblRoute" text="Paris → New York" style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 14px;"/>
                </VBox>
            </HBox>
        </VBox>
    </top>

    <!-- Main Content -->
    <center>
        <HBox spacing="20" style="-fx-padding: 20;">

            <!-- Seat Map -->
            <VBox spacing="15" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER" spacing="20" style="-fx-padding: 10;">
                    <Label text="✈ Front of Aircraft" style="-fx-font-size: 14px; -fx-text-fill: #666;"/>
                </HBox>

                <!-- Seat Legend -->
                <HBox spacing="20" alignment="CENTER" style="-fx-padding: 10; -fx-background-color: #f8f9fa; -fx-background-radius: 8;">
                    <HBox spacing="5" alignment="CENTER">
                        <Rectangle width="20" height="20" style="-fx-fill: #4CAF50; -fx-arc-width: 5; -fx-arc-height: 5;"/>
                        <Label text="Available" style="-fx-font-size: 12px;"/>
                    </HBox>
                    <HBox spacing="5" alignment="CENTER">
                        <Rectangle width="20" height="20" style="-fx-fill: #667eea; -fx-arc-width: 5; -fx-arc-height: 5;"/>
                        <Label text="Selected" style="-fx-font-size: 12px;"/>
                    </HBox>
                    <HBox spacing="5" alignment="CENTER">
                        <Rectangle width="20" height="20" style="-fx-fill: #ccc; -fx-arc-width: 5; -fx-arc-height: 5;"/>
                        <Label text="Occupied" style="-fx-font-size: 12px;"/>
                    </HBox>
                    <HBox spacing="5" alignment="CENTER">
                        <Rectangle width="20" height="20" style="-fx-fill: #FFD700; -fx-arc-width: 5; -fx-arc-height: 5;"/>
                        <Label text="Extra Legroom" style="-fx-font-size: 12px;"/>
                    </HBox>
                    <HBox spacing="5" alignment="CENTER">
                        <Rectangle width="20" height="20" style="-fx-fill: #FF6B6B; -fx-arc-width: 5; -fx-arc-height: 5;"/>
                        <Label text="Exit Row" style="-fx-font-size: 12px;"/>
                    </HBox>
                </HBox>

                <!-- Seat Grid Container -->
                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
                    <VBox fx:id="seatMapContainer" alignment="CENTER" spacing="5" style="-fx-padding: 20;">
                        <!-- Seats will be dynamically generated here -->
                    </VBox>
                </ScrollPane>
            </VBox>

            <!-- Right Panel - Selection Summary -->
            <VBox spacing="15" minWidth="280" maxWidth="280" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2); -fx-padding: 20;">

                <Label text="Your Selection" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                <Separator/>

                <!-- Flight Info -->
                <VBox spacing="5" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-background-radius: 8;">
                    <HBox spacing="10">
                        <Label text="Passengers:" style="-fx-text-fill: #666;"/>
                        <Label fx:id="lblPassengerCount" text="1" style="-fx-font-weight: bold;"/>
                    </HBox>
                    <HBox spacing="10">
                        <Label text="Class:" style="-fx-text-fill: #666;"/>
                        <Label fx:id="lblClassType" text="Economy" style="-fx-font-weight: bold;"/>
                    </HBox>
                </VBox>

                <!-- Selected Seats List -->
                <Label text="Selected Seats" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                <VBox fx:id="selectedSeatsContainer" spacing="8" style="-fx-min-height: 100;">
                    <Label text="No seats selected" style="-fx-text-fill: #999; -fx-font-style: italic;"/>
                </VBox>

                <!-- Seat Preferences -->
                <Separator/>
                <Label text="Quick Select" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                <HBox spacing="10">
                    <Button fx:id="btnAutoAssign" text="Auto-Assign" style="-fx-background-color: #667eea; -fx-text-fill: white; -fx-cursor: hand;" onAction="#handleAutoAssign"/>
                    <Button fx:id="btnClearSelection" text="Clear" style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-cursor: hand;" onAction="#handleClearSelection"/>
                </HBox>

                <Label text="Preference:" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
                <ComboBox fx:id="cmbPreference" promptText="Select preference" maxWidth="Infinity">
                    <items>
                        <javafx.collections.FXCollections fx:factory="observableArrayList">
                            <String fx:value="Any"/>
                            <String fx:value="Window"/>
                            <String fx:value="Aisle"/>
                            <String fx:value="Front"/>
                            <String fx:value="Back"/>
                        </javafx.collections.FXCollections>
                    </items>
                </ComboBox>

                <!-- Price Summary -->
                <Separator/>
                <VBox spacing="8" style="-fx-background-color: #e8f5e9; -fx-padding: 15; -fx-background-radius: 8;">
                    <HBox>
                        <Label text="Base Price:" style="-fx-text-fill: #666;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblBasePrice" text="$0.00" style="-fx-font-weight: bold;"/>
                    </HBox>
                    <HBox>
                        <Label text="Seat Upgrade:" style="-fx-text-fill: #666;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblSeatExtra" text="$0.00" style="-fx-font-weight: bold; -fx-text-fill: #667eea;"/>
                    </HBox>
                    <Separator/>
                    <HBox>
                        <Label text="Total:" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblTotalPrice" text="$0.00" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #4CAF50;"/>
                    </HBox>
                </VBox>

                <!-- Confirm Button -->
                <Region VBox.vgrow="ALWAYS"/>
                <Button fx:id="btnConfirmSeats" text="Confirm Seat Selection"
                        maxWidth="Infinity" prefHeight="45"
                        style="-fx-background-color: linear-gradient(to right, #667eea, #764ba2); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"
                        onAction="#handleConfirmSeats"/>
            </VBox>
        </HBox>
    </center>

    <!-- Bottom Status Bar -->
    <bottom>
        <HBox alignment="CENTER" spacing="20" style="-fx-background-color: #f8f9fa; -fx-padding: 15;">
            <Label fx:id="lblStatus" text="Click on a seat to select it" style="-fx-text-fill: #666;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblAvailableCount" text="Available: 150 seats" style="-fx-text-fill: #4CAF50; -fx-font-weight: bold;"/>
        </HBox>
    </bottom>

</BorderPane>
