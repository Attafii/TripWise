<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="ui.controllers.ApprovalDetailsController"
      spacing="12">

    <!-- FIX: use Insets element instead of padding="16" -->
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <Label text="Détails de la demande" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="8">
        <columnConstraints>
            <ColumnConstraints percentWidth="35"/>
            <ColumnConstraints percentWidth="65"/>
        </columnConstraints>
        <children>
            <Label text="Employé:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <Label fx:id="empLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Référence:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <Label fx:id="refLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Montant:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <Label fx:id="amountLabel" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Date:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <Label fx:id="dateLabel" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <Label text="Statut:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <Label fx:id="statusLabel" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
        </children>
    </GridPane>

    <Label text="Commentaire (obligatoire pour le rejet)"/>
    <TextArea fx:id="rejectComment" promptText="Raison du rejet..." prefRowCount="3"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="approveBtn" text="Approuver" onAction="#onApprove"/>
        <Button fx:id="rejectBtn"  text="Rejeter"    onAction="#onReject"/>
    </HBox>
</VBox>