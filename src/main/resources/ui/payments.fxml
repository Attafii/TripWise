<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="ui.controllers.PaymentsController"
      spacing="24" style="-fx-background-color: #f5f7fa;" stylesheets="@style.css">
    <padding>
        <Insets top="24" right="32" bottom="24" left="32" />
    </padding>

    <!-- Header -->
    <VBox spacing="6">
        <Label fx:id="pageTitle" text="Payments" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1a202c;" />
        <Label fx:id="pageSubtitle" text="Manage payments" style="-fx-font-size: 14px; -fx-text-fill: #718096;" />
    </VBox>

    <!-- Stats Row -->
    <HBox spacing="20">
        <VBox spacing="8" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);"
              HBox.hgrow="ALWAYS">
            <Label fx:id="stat1Title" text="Stat 1" style="-fx-font-size: 12px; -fx-text-fill: #6b7280; -fx-font-weight: 500;" />
            <Label fx:id="stat1Label" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #1f2937;" />
        </VBox>
        
        <VBox spacing="8" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);"
              HBox.hgrow="ALWAYS">
            <Label fx:id="stat2Title" text="Stat 2" style="-fx-font-size: 12px; -fx-text-fill: #6b7280; -fx-font-weight: 500;" />
            <Label fx:id="stat2Label" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #1f2937;" />
        </VBox>
        
        <VBox spacing="8" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);"
              HBox.hgrow="ALWAYS">
            <Label fx:id="stat3Title" text="Stat 3" style="-fx-font-size: 12px; -fx-text-fill: #6b7280; -fx-font-weight: 500;" />
            <Label fx:id="stat3Label" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #1f2937;" />
        </VBox>
    </HBox>

    <!-- Payment Cards Section -->
    <VBox spacing="16" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Payment Methods" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1f2937;" />
            <Region HBox.hgrow="ALWAYS" />
            <Button text="+ Add Payment Method" onAction="#handleAddPaymentMethod"
                   style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 16; -fx-cursor: hand; -fx-font-size: 13px; -fx-font-weight: 600;" />
        </HBox>

        <Separator style="-fx-background-color: #e5e7eb;" />

        <!-- Payment Cards Container -->
        <HBox fx:id="paymentCardsBox" spacing="16" prefHeight="180">
        </HBox>
    </VBox>

    <!-- Transaction History -->
    <VBox spacing="16" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);"
          VBox.vgrow="ALWAYS">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Transaction History" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1f2937;" />
            <Region HBox.hgrow="ALWAYS" />
            <ComboBox fx:id="statusFilterCombo" promptText="Filter by status" style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-radius: 6; -fx-background-radius: 6;" />
        </HBox>

        <Separator style="-fx-background-color: #e5e7eb;" />

        <!-- Transactions Table -->
        <TableView fx:id="transactionsTable" VBox.vgrow="ALWAYS"
                  style="-fx-background-color: transparent; -fx-background-radius: 8;">
            <columns>
                <TableColumn fx:id="dateColumn" text="Date &amp; Time" prefWidth="180" />
                <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="300" />
                <TableColumn fx:id="typeColumn" text="Payment Type" prefWidth="150" />
                <TableColumn fx:id="amountColumn" text="Amount" prefWidth="120" />
                <TableColumn fx:id="statusColumn" text="Status" prefWidth="120" />
            </columns>
            <placeholder>
                <VBox alignment="CENTER" spacing="10" style="-fx-padding: 40;">
                    <Label text="💳" style="-fx-font-size: 48px;" />
                    <Label text="No transactions found" style="-fx-text-fill: #a0aec0; -fx-font-size: 16px; -fx-font-weight: 500;" />
                    <Label text="Your payment history will appear here" style="-fx-text-fill: #cbd5e0; -fx-font-size: 13px;" />
                </VBox>
            </placeholder>
        </TableView>
    </VBox>
</VBox>
