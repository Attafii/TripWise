<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns:fx="http://javafx.com/fxml" fx:controller="ui.controllers.PaymentsController"
            fitToWidth="true" style="-fx-background-color: #f8f9fa; -fx-border-color: transparent;">
    <VBox spacing="25" style="-fx-background-color: #f8f9fa; -fx-padding: 25;">

        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="15">
            <VBox spacing="3">
                <Label text="Payments and Transactions" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                <Label text="View your payment history and manage transactions" style="-fx-font-size: 14px; -fx-text-fill: #6b7280;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Refresh" onAction="#refreshPayments"
                   style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand;"/>
        </HBox>

        <!-- Payment Stats -->
        <HBox spacing="20">
            <VBox spacing="10" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                <Label text="Total Spent" style="-fx-font-size: 14px; -fx-text-fill: #6b7280;"/>
                <Label fx:id="totalSpentLabel" text="0.00 USD" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #3b82f6;"/>
            </VBox>

            <VBox spacing="10" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                <Label text="Pending Payments" style="-fx-font-size: 14px; -fx-text-fill: #6b7280;"/>
                <Label fx:id="pendingPaymentsLabel" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #f59e0b;"/>
            </VBox>

            <VBox spacing="10" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                <Label text="Completed" style="-fx-font-size: 14px; -fx-text-fill: #6b7280;"/>
                <Label fx:id="completedPaymentsLabel" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #10b981;"/>
            </VBox>

            <VBox spacing="10" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                <Label text="This Month" style="-fx-font-size: 14px; -fx-text-fill: #6b7280;"/>
                <Label fx:id="thisMonthLabel" text="0.00 USD" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #8b5cf6;"/>
            </VBox>
        </HBox>

        <!-- Filter Tabs -->
        <HBox spacing="10">
            <ToggleButton fx:id="allPaymentsBtn" text="All" selected="true" onAction="#filterAll"
                         style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 20;"/>
            <ToggleButton fx:id="flightsBtn" text="Flights" onAction="#filterFlights"
                         style="-fx-background-color: #e5e7eb; -fx-text-fill: #374151; -fx-background-radius: 8; -fx-padding: 8 20;"/>
            <ToggleButton fx:id="hotelsBtn" text="Hotels" onAction="#filterHotels"
                         style="-fx-background-color: #e5e7eb; -fx-text-fill: #374151; -fx-background-radius: 8; -fx-padding: 8 20;"/>
            <ToggleButton fx:id="carsBtn" text="Car Rentals" onAction="#filterCars"
                         style="-fx-background-color: #e5e7eb; -fx-text-fill: #374151; -fx-background-radius: 8; -fx-padding: 8 20;"/>
        </HBox>

        <!-- Transactions List -->
        <VBox fx:id="transactionsContainer" spacing="15" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20;">
            <HBox alignment="CENTER_LEFT">
                <Label text="Transaction History" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="sortCombo" promptText="Sort by" style="-fx-background-radius: 8;"/>
            </HBox>
            <Separator/>
        </VBox>

    </VBox>
</ScrollPane>
