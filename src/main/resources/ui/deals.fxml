<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="ui.controllers.DealsController"
      spacing="24" style="-fx-background-color: #f5f7fa;">
    <padding>
        <Insets top="24" right="32" bottom="24" left="32" />
    </padding>

    <!-- Header -->
    <VBox spacing="6">
        <Label fx:id="pageTitle" text="Travel Deals" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1a202c;" />
        <Label fx:id="pageSubtitle" text="Exclusive travel offers" style="-fx-font-size: 14px; -fx-text-fill: #718096;" />
    </VBox>

    <!-- Stats Row -->
    <HBox spacing="20">
        <VBox spacing="8" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);"
              HBox.hgrow="ALWAYS">
            <Label fx:id="stat1Title" text="Stat 1" style="-fx-font-size: 12px; -fx-text-fill: #6b7280; -fx-font-weight: 500;" />
            <Label fx:id="stat1Label" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #1f2937;" />
        </VBox>
        
        <VBox spacing="8" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);"
              HBox.hgrow="ALWAYS">
            <Label fx:id="stat2Title" text="Stat 2" style="-fx-font-size: 12px; -fx-text-fill: #6b7280; -fx-font-weight: 500;" />
            <Label fx:id="stat2Label" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #1f2937;" />
        </VBox>
        
        <VBox spacing="8" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);"
              HBox.hgrow="ALWAYS">
            <Label fx:id="stat3Title" text="Stat 3" style="-fx-font-size: 12px; -fx-text-fill: #6b7280; -fx-font-weight: 500;" />
            <Label fx:id="stat3Label" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #1f2937;" />
        </VBox>
    </HBox>

    <!-- Filters -->
    <HBox spacing="16" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);">
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Category" style="-fx-font-size: 12px; -fx-text-fill: #6b7280; -fx-font-weight: 500;" />
            <ComboBox fx:id="categoryFilter" onAction="#handleFilterChange"
                     style="-fx-background-color: #f3f4f6; -fx-border-width: 0; -fx-background-radius: 8; -fx-pref-width: 200;" />
        </VBox>
        
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Sort By" style="-fx-font-size: 12px; -fx-text-fill: #6b7280; -fx-font-weight: 500;" />
            <ComboBox fx:id="sortFilter" onAction="#handleFilterChange"
                     style="-fx-background-color: #f3f4f6; -fx-border-width: 0; -fx-background-radius: 8; -fx-pref-width: 200;" />
        </VBox>
        
        <Region HBox.hgrow="ALWAYS" />
        
        <VBox alignment="BOTTOM_RIGHT">
            <Button text="🔍 Advanced Filters" 
                   style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand; -fx-font-size: 13px; -fx-font-weight: 600;" />
        </VBox>
    </HBox>

    <!-- Deals Grid -->
    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
        <GridPane fx:id="dealsGrid" hgap="20" vgap="20" style="-fx-background-color: transparent; -fx-padding: 4;">
        </GridPane>
    </ScrollPane>
</VBox>
