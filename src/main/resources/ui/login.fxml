<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns:fx="http://javafx.com/fxml" 
           fx:controller="ui.controllers.LoginController" 
           styleClass="login-root" 
           stylesheets="@style.css"
           fx:id="rootPane">
    
    <!-- Main Login Card -->
    <VBox alignment="CENTER" spacing="0" styleClass="login-card" fx:id="loginCard">
        <padding>
            <Insets top="48" right="56" bottom="48" left="56" />
        </padding>

        <!-- Logo Section -->
        <VBox alignment="CENTER" spacing="8" styleClass="logo-container">
            <Label text="TripWise" styleClass="logo-icon" />

            <Label text="Your Journey, Simplified" styleClass="brand-subtitle" />
        </VBox>

        <!-- Welcome Text -->
        <VBox alignment="CENTER_LEFT" spacing="4" style="-fx-padding: 0 0 32 0;">
            <Label text="Welcome Back" styleClass="login-title" />
            <Label text="Sign in to continue your adventure" styleClass="login-subtitle" />
        </VBox>

        <!-- Login Form -->
        <VBox spacing="24" style="-fx-fill-width: true;">
            
            <!-- Email Field -->
            <VBox spacing="8" styleClass="form-field-container">
                <Label text="Email Address" styleClass="input-label" />
                <TextField fx:id="emailField" 
                          promptText="you@example.com" 
                          styleClass="modern-input"
                          onAction="#handleLogin" />
            </VBox>

            <!-- Password Field -->
            <VBox spacing="8" styleClass="form-field-container">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Password" styleClass="input-label" HBox.hgrow="ALWAYS" />
                    <Hyperlink text="Forgot?" styleClass="text-link" style="-fx-font-size: 12px;" />
                </HBox>
                <PasswordField fx:id="passwordField" 
                              promptText="Enter your password" 
                              styleClass="modern-input"
                              onAction="#handleLogin" />
            </VBox>

            <!-- Remember Me Checkbox -->
            <HBox alignment="CENTER_LEFT" spacing="8">
                <CheckBox fx:id="rememberMeCheckbox" text="Remember me" />
            </HBox>

            <!-- Error/Success Message -->
            <Label fx:id="messageLabel" 
                   styleClass="error-label" 
                   wrapText="true"
                   managed="false" 
                   visible="false" />

            <!-- Login Button -->
            <Button text="Sign In" 
                    fx:id="loginButton"
                    onAction="#handleLogin" 
                    maxWidth="Infinity" 
                    styleClass="btn-primary" 
                    prefHeight="48"
                    defaultButton="true" />

            <!-- Divider -->
            <HBox alignment="CENTER" spacing="16" styleClass="divider-container">
                <Separator HBox.hgrow="ALWAYS" styleClass="divider-line" />
                <Label text="or" styleClass="divider-text" />
                <Separator HBox.hgrow="ALWAYS" styleClass="divider-line" />
            </HBox>

            <!-- Sign Up Link -->
            <HBox alignment="CENTER" spacing="6">
                <Label text="Don't have an account?" style="-fx-text-fill: #6b7280; -fx-font-size: 14px;" />
                <Hyperlink text="Create Account" 
                          onAction="#handleSignUp" 
                          styleClass="text-link"
                          style="-fx-font-size: 14px;" />
            </HBox>

        </VBox>
    </VBox>

    <!-- Loading Indicator (Hidden by default) -->
    <StackPane fx:id="loadingOverlay" 
               visible="false" 
               managed="false"
               style="-fx-background-color: rgba(0, 0, 0, 0.4);">
        <VBox alignment="CENTER" spacing="16" 
              style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 32;">
            <ProgressIndicator styleClass="loading-spinner" />
            <Label text="Signing in..." style="-fx-font-size: 14px; -fx-text-fill: #6b7280;" />
        </VBox>
    </StackPane>

</StackPane>
